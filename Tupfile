!quant = |> ^t^ pngquant --transbug -o %o %f |>

: foreach wadsrc/prototype/*.png |> !quant |> wadsrc/prototype/quant/%b {prototype}
: foreach wadsrc/solvent/*.png |> !quant |> wadsrc/solvent/quant/%b {solvent}
: foreach wadsrc/natrite/*.png |> !quant |> wadsrc/natrite/quant/%b {natrite}

: {prototype} |> goldutil wad create --out %o %f |> prototype.wad {wads}
: {solvent} |> goldutil wad create --out %o %f |> solvent.wad {wads}
: {natrite} |> goldutil wad create --out %o %f |> natrite.wad {wads}

: foreach mapssrc/*.map | {wads} |> bin/buildmap-ericw %f %o -f |> maps/%B.bsp | %O.prt %O.texinfo.json %O.content.json {bsps}
