#!/usr/bin/env sh

set -eux

hldir="$HOME/.steam/root/steamapps/common/Half-Life"
mod="$(basename "$(realpath "$(dirname "$0")/..")")"

remap() {
    goldutil bsp remap-materials \
        --original-materials="$hldir/valve/sound/materials.txt" \
        --replacement-materials="$hldir/$mod/sound/makkon.materials.txt" \
        --out "$hldir/$mod/maps/$1.remapped" \
        --verbose \
        "maps/$1.bsp"

    mv "maps/$1.bsp" "maps/$1.bak"
    mv "maps/$1.remapped" "maps/$1.bsp"
    mv "maps/$1.bak" "maps/$1.bsp"
}

makepackage() {
    remap "$1"
    rm -f "$1.zip" || true
    list="$(mktemp --suffix .list)"
    cp "maps/$1.res" "$list"
    (
    echo "maps/$1.bsp"
    echo "mapssrc/$1.map"
    echo "maps/$1.res"
    echo "maps/$1.readme.txt"
    ) >> "$list"
    zip "$1.zip" -@ < "$list"
    rm -f "$list"
}

makepackage "$1"
