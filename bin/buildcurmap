#!/usr/bin/env sh

set -eux

(
cd "$(realpath "$(dirname "$0")/..")"

latest="$(find mapssrc -maxdepth 1 -type f -name '*.map' -printf "%T+ %p\n" | grep -Ev '(.exported.map|.inc.map)' | sort -r | head -n1 | cut -d' ' -f2)"
name="${latest%.*}"
name="${name#mapssrc/}"

if [ "${1:-}" != "-run" ]; then
    bin/buildmap-ericw "$latest" "$(dirname "$latest")/../maps/$name.bsp" "$@"
fi

bin/run +map "$name"
)
