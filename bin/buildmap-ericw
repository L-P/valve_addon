#!/usr/bin/env bash

set -eux

hldir="$(realpath "$(dirname "$0")/../..")"
bsp="$2"
mapsdir="$(basename "$(dirname "$2")")"
mkdir -p "$mapsdir"
exported="$mapsdir/$(basename "$1")"

goldutil map export --cleanup-tb "$1" | goldutil map neat > "$exported"

opts=(-nolog -noverbose)
qbspopts=("${opts[@]}" -hlbsp -leaktest -wadpath "$hldir" -tjunc retopologize -nosoftware -forcegoodtree -texturedefs texturedefs.def)
visopts=("${opts[@]}" -noambient)

# Is this a bug? light won't read the wad key we have to manually add paths.
wads="$(sed -nE 's/"wad" "(.+)"/\1/p' "$exported" | tr ';' '\n' | sed "s|^|-path $hldir/|")"
lightopts=(
    "${opts[@]}"
    $wads
    -surflight_radiosity 1 -dirt 1 -bounce 1 -bouncestyled 1
)

vis=1
light=1

if [ $# -gt 2 ]; then
    case "$3" in
        -fast)
            visopts+=(-fast)
            lightopts+=(-dirtdebug -dirtscale 2)
            ;;
        -ent)
            qbspopts+=(-onlyents)
            lightopts+=(-onlyents)
            vis=0
            ;;
    esac
else
    lightopts+=(-extra4 -gate 1.0)
fi

qbsp "${qbspopts[@]}" "$exported" "$bsp"

if [ "$vis" -eq 1 ]; then
    vis "${visopts[@]}" "$bsp"
fi

if [ "$light" -eq 1 ]; then
    light "${lightopts[@]}" "$bsp"
fi

rm "$exported"

goldutil bsp remap-materials \
    --original-materials="$hldir/valve/sound/materials.txt" \
    --replacement-materials="sound/makkon.materials.txt" \
    --out "$bsp.remapped" \
    --verbose \
    "$bsp"

mv "$bsp.remapped" "$bsp"

goldutil bsp limits "$bsp"
